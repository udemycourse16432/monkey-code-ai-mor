@page "/sign-in"
@model MillionsOfRecordsApp.Pages.SignInModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="my-account">
    <div class="container-fluid">
        <ul class="top-nav clearfix">
            <li>
                <a href="/">Home</a>
            </li>
            <li>Sign In</li>
        </ul>
        <div class="my-account-block">
            <div class="row">
                <div class="col-sm-6 sign-in-block">
                    <h2>Returning Customers</h2>
                    <h6>Sign in to your existing account.</h6>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning">
                            @Model.ErrorMessage
                        </div>
                    }
                    <form method="post">
                        <div class="form-group">
                            @* <input asp-for="Email" type="email" placeholder="Email Address" class="form-control" required value="sf@1234gorecords.com" /> *@
                            <input asp-for="Email" type="email" placeholder="Email Address" class="form-control" required value="jane.doe@testmor.com" />
                        </div>
                        <div class="form-group">
                            <input asp-for="Password" type="password" placeholder="Password" class="form-control" required />
                        </div>

                        <a class="forgot-password" href="/forgot-password">
                            Forgot Password?
                        </a>
                        <br />
                        <button class="btn btn-add-to-cart" type="submit">
                            Sign in
                        </button>

                        <p class="mt-3">
                            Can't sign in? For a quick response, <a href="#" data-toggle="modal" data-target="#contactUsModal">contact us</a> and we will reply with your email/password so you can sign in. Thank you.
                        </p>
                    </form>
                </div>

                <div class="col-sm-6 sign-up-block">
                    <h2>New Customers</h2>
                    <p>
                        Note: If you are a record store or other type of reseller (Facebook, eBay, etc.), you can create your wholesale account by clicking <a href="/country?wr=w">here.</a> Your wholesale account will be
                        opened instantly so you can begin ordering today.
                    </p>
                    <a class="btn btn-add-to-cart" href="/country?wr=r">
                        Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Us Modal -->
<div class="modal fade" id="contactUsModal" tabindex="-1" role="dialog" aria-labelledby="contactUsModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="contactUsModalLabel">Contact Us</h4>
            </div>
            <div class="modal-body">
                <p>Enter your contact information and your message for us, then click Submit.</p>

                <div id="contactUsAlert" class="alert hidden" role="alert"></div>

                <form id="contactUsForm">
                    @Html.AntiForgeryToken()

                    @* Honeypot field - visually hidden using inline style/bootstrap class *@
                    <div style="display:none;" aria-hidden="true">
                        <input asp-for="ContactForm.Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ContactForm.YourName">Your Name <span class="text-danger">*</span></label>
                        <input asp-for="ContactForm.YourName" class="form-control" id="contactYourName" maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ContactForm.YourEmail">Your Email Address <span class="text-danger">*</span></label>
                        <input asp-for="ContactForm.YourEmail" type="email" class="form-control" id="contactYourEmail" maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ContactForm.YourPhone">Your Phone (optional)</label>
                        <input asp-for="ContactForm.YourPhone" type="tel" class="form-control" id="contactYourPhone" maxlength="30" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ContactForm.Message">Message <span class="text-danger">*</span></label>
                        <textarea asp-for="ContactForm.Message" class="form-control" id="contactMessage" rows="4" maxlength="1000"></textarea>
                        <span class="help-block text-right" style="margin-top: 4px; font-size: 12px; color: #737373;">
                            Maximum 1,000 characters
                        </span>
                    </div>

                    <button type="submit" id="btnContactSubmit" class="btn btn-primary btn-block">
                        <i id="contactSpinner" class="fa fa-spinner fa-spin hidden"></i>
                        Submit
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/pages/signIn.css" asp-append-version="true" />
}
@section Scripts {
    <script>
        $(document).ready(function () {
            var $modal = $('#contactUsModal');
            var $form = $('#contactUsForm');
            var $alertBox = $('#contactUsAlert');
            var $spinner = $('#contactSpinner');
            var $submitBtn = $('#btnContactSubmit');

            // Helper function to reset the form and clear alert states
            function resetContactForm() {
                $form[0].reset();
                $alertBox.addClass('hidden').removeClass('alert-success alert-danger').text('');
                $spinner.addClass('hidden');
                $submitBtn.prop('disabled', false);
            }

            // Bootstrap 3 Event: Fires immediately when the show instance method is called
            $modal.on('show.bs.modal', function () {
                resetContactForm();
            });

            // Form Submit Handler
            $form.on('submit', async function (e) {
                e.preventDefault();

                $alertBox.addClass('hidden').removeClass('alert-success alert-danger');
                $spinner.removeClass('hidden');
                $submitBtn.prop('disabled', true);

                var formData = new FormData(this);

                try {
                    const response = await fetch('?handler=ContactUs', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        $alertBox.addClass('alert-success').text(result.message).removeClass('hidden');
                        $form[0].reset();
                    } else {
                        // Log full backend response to browser console for easy inspection
                        console.error('Contact Us Submission Error:', result);

                        var errorList = '<ul style="margin-bottom:0; padding-left:20px;">';
                        $.each(result.errors, function (i, err) {
                            errorList += '<li>' + err + '</li>';
                        });
                        errorList += '</ul>';

                        $alertBox.addClass('alert-danger').html(errorList).removeClass('hidden');
                    }
                } catch (err) {
                    console.error('Network / Request Error:', err);
                    $alertBox.addClass('alert-danger').text('A network error occurred. Please check your internet connection and try again.').removeClass('hidden');
                } finally {
                    $spinner.addClass('hidden');
                    $submitBtn.prop('disabled', false);
                }
            });
        });
    </script>
}