@page "/forgot-password"
@model MillionsOfRecordsApp.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="my-account">
    <div class="container-fluid">
        <ul class="top-nav clearfix">
            <li><a href="/">Home</a></li>
            <li><a asp-page="/SignIn">Sign In</a></li>
            <li>Forgot Password</li>
        </ul>

        <div class="my-account-block">
            <div class="row">
                <div class="col-sm-8 offset-sm-2 col-md-6 offset-md-3 sign-in-block" style="border-right: none;">
                    <h2>Reset Password</h2>

                    @if (Model.IsSent)
                    {
                        <div class="alert alert-success" style="margin-top: 20px;">
                            <h6>Check your email</h6>
                            <p>If an account exists for <strong>@Model.Email</strong>, you will receive a password reset link shortly.</p>
                            <a asp-page="/SignIn" class="btn btn-add-to-cart">Back to Sign In</a>
                        </div>
                    }
                    else
                    {
                        <h6>Enter your email address and we'll send you a link to reset your password.</h6>

                        <form method="post">
                            <div class="form-group">
                                <input asp-for="Email" type="email" placeholder="Email Address" class="form-control" required />
                            </div>

                            <button class="btn btn-add-to-cart" type="submit">
                                Send Reset Link
                            </button>

                            <p class="mt-3">
                                Remembered your password? <a asp-page="/SignIn">Sign in here.</a>
                            </p>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    @* Reusing Sign-In styles to maintain consistency *@
    <link rel="stylesheet" href="~/css/pages/signIn.css" asp-append-version="true" />
    <style>
        /* Small local override to center the single column reset form */
        .sign-in-block {
            margin: 0 auto;
            float: none;
        }

        @@media screen and (max-width: 767px) {
            .sign-in-block {
                border-bottom: none !important;
            }
        }
    </style>
}