@page "/forgot-password"
@model MillionsOfRecordsApp.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="my-account">
    <div class="container-fluid">
        <ul class="top-nav clearfix">
            <li><a href="/">Home</a></li>
            <li><a asp-page="/SignIn">Sign In</a></li>
            <li>Forgot Password</li>
        </ul>

        <div class="my-account-block">
            <div class="row">
                <div class="col-sm-8 col-sm-offset-2 col-md-6 col-md-offset-3 sign-in-block" style="border-right: none; float: none; margin: 0 auto;">
                    <h2>Forgot Your Password?</h2>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (Model.IsSent)
                    {
                        <div class="alert alert-success" style="margin-top: 20px;">
                            <div class="media">
                                <div class="media-left">
                                    <i class="fa fa-check-circle fa-2x text-success" aria-hidden="true"></i>
                                </div>
                                <div class="media-body">
                                    <h4 class="media-heading" style="margin-top: 2px;">Check your email</h4>
                                    <p style="margin-bottom: 0;">
                                        We have sent a message to <strong>@Model.Email</strong> containing your password.
                                        If you don't receive it, please check your spam/bulk email folder.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <a asp-page="/SignIn" class="btn btn-add-to-cart mt-3">
                            Back to Sign In
                        </a>
                    }
                    else if (Model.AccountNotFound)
                    {
                        <div class="alert alert-warning" style="margin-top: 20px;">
                            <div class="media">
                                <div class="media-left">
                                    <i class="fa fa-exclamation-triangle fa-2x text-warning" aria-hidden="true"></i>
                                </div>
                                <div class="media-body">
                                    <p style="font-size: 14px; color: #333; margin-bottom: 0;">
                                        We could not find an account associated with that email address.
                                        We suggest that you create a new account using that email address by clicking below. Thank you.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <a href="/country?wr=r" class="btn btn-add-to-cart">
                                Create Account
                            </a>
                            <a asp-page="/ForgotPassword" class="btn btn-default ml-2" style="margin-left: 10px;">
                                Try Another Email
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="p-text-2" style="margin-bottom: 20px; line-height: 1.5;">
                            Enter the email address associated with your account, then click Submit. We'll instantly email your password so you can use it to sign in.
                            If you don't receive the email immediately, please check your spam folder.
                        </p>

                        <form method="post">
                            <div class="form-group">
                                <label asp-for="Email" class="control-label">Your Email Address <small class="text-muted">(The one you sign in with)</small></label>
                                <input asp-for="Email" type="email" placeholder="Email Address" class="form-control" maxlength="100" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button class="btn btn-add-to-cart" type="submit">
                                Submit
                            </button>

                            <p class="mt-3">
                                Remembered your password? <a asp-page="/SignIn">Sign in here.</a>
                            </p>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/signIn.css" asp-append-version="true" />
}