@page "/help-shipping"
@model MillionsOfRecordsApp.Pages.HelpShippingModel
@{
    ViewData["Title"] = "Shipping & Payment";
}

<section class="help-shipping">
    <div class="container-fluid">
        <ul class="top-nav clearfix">
            <li>
                <a href="/">Home</a>
            </li>
            <li>Shipping & Payment</li>
        </ul>
        <div class="container">
            <div class="text-content">
                <h2>Shipping & Payment</h2>
                <h4>SHIPPING</h4>
                <p>We ship to all countries. We sell to individuals as well as wholesale customers (record stores, online sellers, etc.). No minimum order requirement.</p>
                <p>
                    The shipping charge depends on your location, the weight of your package, and the shipping method you select. After you have added items to your Cart, view the Cart to see the shipping
                    charge.
                </p>
                <p>You will notice a huge savings in shipping cost as you add more items to your Cart.</p>
                <p>All orders ship same-day, 7 days a week.</p>
                <p>
                    No bent LP corners or broken CDs - please see our <a asp-page="/Returns">Packaging Guarantee</a> to learn more about our industry-leading order packaging.
                </p>
                <p>All orders include tracking, insurance and our deliver guarantee at no extra charge. We guarantee your order against loss or damage in transit.</p>

                <div class="list-block">
                    <h5>SHIPPING OPTIONS (USA)</h5>
                    <ul class="list">
                        <li>USPS Media Mail</li>
                        <li>USPS First-Class</li>
                        <li>USPS Priority</li>
                        <li>FedEx Ground</li>
                    </ul>
                </div>
                <div class="list-block">
                    <h5>SHIPPING OPTIONS (INTERNATIONAL)</h5>
                    <ul class="list">
                        <li>USPS First-Class (Air Mail)</li>
                        <li>USPS Priority (Air Mail)</li>
                        <li>FedEx (Intl Express)</li>
                    </ul>
                </div>
            </div>

            <div class="text-content">
                <h4>PAYMENT</h4>
                <div class="list-block">
                    <h5>We accept these payment methods (no fees):</h5>
                    <ul class="list">
                        <li>PayPal</li>
                        <li>Visa and MasterCard (credit cards and debit cards)</li>
                        <li>Amex</li>
                        <li>Discover</li>
                        <li>Personal checks</li>
                        <li>Company checks</li>
                        <li>Money Orders</li>
                        <li>Cashier's Checks</li>
                        <li>Net Terms</li>
                        <li>Bank Transfer ($200+ orders)</li>
                        <li>Cash (for mail-order customers who find it convenient to mail cash)</li>
                    </ul>
                </div>
                <p>
                    We don't accept Western Union
                    <br />
                    We don't ship COD
                </p>
                <p>We don't charge extra fees for any payment methods (PayPal, credit card, etc.)</p>
            </div>
        </div>
    </div>
</section>

