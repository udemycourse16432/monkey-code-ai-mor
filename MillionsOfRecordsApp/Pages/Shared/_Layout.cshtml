@inject IHttpContextAccessor HttpContextAccessor
@{
    bool isLoggedIn = HttpContextAccessor.HttpContext?.Session.IsLoggedIn() ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* Ported from React index.html *@
    <meta name="theme-color" content="#000000">
    <meta name="description" content="Millions Of Records">
    
    <title>@ViewData["Title"] - Millions Of Records</title>
    <link rel="icon" href="~/favicon.png">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&amp;display=swap" rel="stylesheet">
    
        <link href="~/css/index.css" rel="stylesheet" />
    
        <link href="~/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/css/font-awesome.min.css" rel="stylesheet" />
        <link href="~/css/magnific-popup.css" rel="stylesheet" />
        <link href="~/css/primereact-theme.css" rel="stylesheet" />
        <link href="~/fonts/remixicon.css" rel="stylesheet" />
        <link href="~/css/toastr.min.css" rel="stylesheet" />
        <link href="~/css/toastr-brand.css" rel="stylesheet" />
        <link href="~/css/App.css" rel="stylesheet" />
        <link href="~/css/components/header.css" rel="stylesheet" />
        <link href="~/css/components/contentPopup.css" rel="stylesheet" />
        <link href="~/css/components/socialIcons.css" rel="stylesheet" />
        <link href="~/css/components/footer.css" rel="stylesheet" />
        <link href="~/css/components/newsletter.css" rel="stylesheet" />
        @await RenderSectionAsync("Styles", required: false)
        
    </head>
    <body>
        @* Just after the <body> tag *@
        <div id="global-loader" class="loading-view" data-testid="layout-global-loader">
            <img src="~/assets/images/disk-animation.gif" alt="Loading..." />
        </div>
        <noscript>You need to enable JavaScript to run this app.</noscript>

        @* This acts as your <div id="root"></div> *@
        <div id="root">
            @await Html.PartialAsync("_Header")
            @await Html.PartialAsync("_ScrollToTop")
            <main role="main">
                @* Equivalent to <Routes> (Determined by Controller) *@
                @RenderBody()
            </main>
            @await Html.PartialAsync("_Newsletter", new ViewDataDictionary(ViewData) {
            { "IsLoggedIn", isLoggedIn  }
        })
            @await Html.PartialAsync("_Footer")
        </div>
        <script src="~/js/lib/jquery.min.js"></script>
        <script src="~/js/lib/jquery.matchHeight-min.js"></script>
        <script src="~/js/lib/bootstrap.min.js"></script>
        <script src="~/js/lib/jquery.magnific-popup.min.js"></script>
        <script src="~/js/lib/toastr.min.js"></script>

        @* Shared App Scripts Here *@
        <script>
                // We point everything to LOCAL routes in your Razor App
                window.AppConfig = {
                    INVENTORY_LIST: "/api/inventory",
                    ALBUM_DETAILS: "/api/album-details/",
                    ARTIST_SUGGESTIONS: "/api/suggestions/artists?search=",
                    GENRE_SUGGESTIONS: "/api/suggestions/genres?search=",
                    LABEL_SUGGESTIONS: "/api/suggestions/labels?search=",
                    ALBUM_SUGGESTIONS: "/api/suggestions/albums?search=",
                    FILTERS_LIST: "/api/filters",
                    PAYPAL_CLIENT_ID: "@(Configuration.GetValue<string>("Paypal:ClientId"))"
                };
                
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-bottom-center",
                    "timeOut": "5000",
                    "extendedTimeOut": "1000",

                    // ANIMATION SETTINGS
                    "showMethod": "slideDown", // jQuery slide for entry
                    "showDuration": "400",
                    "hideMethod": "fadeOut",   // This triggers the .fadeOut class for our CSS
                    "hideDuration": "500"      // MUST match the 0.5s in your CSS animation
                };

                // HIDE LOADER: Wait for the window to finish loading everything
                window.addEventListener('load', function() {
                    var loader = document.getElementById('global-loader');
                    if (loader) {
                        // Add a smooth fade-out instead of a sudden disappearance
                        loader.style.transition = "opacity 0.4s ease, visibility 0.4s";
                        loader.style.opacity = "0";
                        loader.style.visibility = "hidden";

                        // Remove from DOM after transition finishes
                        setTimeout(() => loader.remove(), 400);
                    }
                });
        </script>
        <script src="~/js/components/contentPopup.js" asp-append-version="true"></script>
        <script src="~/js/components/header.js" asp-append-version="true"></script>
        <script src="~/js/shared/cart.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
        
        <mini-profiler position="RenderPosition.BottomRight" />
    </body>
</html>