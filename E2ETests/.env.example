# Base URL of the running MillionsOfRecordsApp instance (Kestrel / IIS Express).
BASE_URL=https://localhost:7244

# An existing customer account used by authenticated screen tests (SignIn flow).
# Leave empty to skip authenticated specs.
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=your-password

# A valid in-stock inventory item ID used by cart / album-details tests.
# Run `curl -k "https://localhost:7244/shop"` and pick any album to find an ID.
TEST_ITEM_ID=123456

# A known good order number (format WEB-000-000-000) used by the Success page spec.
TEST_ORDER_NUMBER=WEB-000-000-000

# Legacy HTTPDownloadDataOK.aspx endpoint password from appsettings (LegacyApiSettings:DownloadDataPassword).
LEGACY_DOWNLOAD_PASSWORD=

# PayPal sandbox client ID used by the checkout page (only needed to assert the SDK script loads).
# Defaults to the value in appsettings.json if not provided.
PAYPAL_CLIENT_ID=
